PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
# Example: mongodb://127.0.0.1:27017/lifeos or mongodb+srv://<user>:<password>@cluster0.mongodb.net/lifeos
MONGO_URI=mongodb://127.0.0.1:27017/lifeos

# JWT Configuration
JWT_SECRET=super_secret_jwt_key_lifeos_production_standard_at_least_32_characters
JWT_EXPIRES_IN=7d

# Client URL (for CORS and Cookie security)
CLIENT_URL=http://localhost:5173

# AI (Groq API)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# File Upload Limit in Bytes (default 10MB)
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
